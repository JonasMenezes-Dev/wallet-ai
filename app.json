{
  "expo": {
    "name": "Wallet AI",
    "slug": "wallet-ai",
    "version": "2.1.0",
    "orientation": "portrait",
    "scheme": "walletai",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.walletai.app",
      "versionCode": 5,
      "predictiveBackGestureEnabled": false,
      "permissions": ["POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/wallet-adaptive-foreground.png",
        "backgroundColor": "#0B0F14"
      }
    },
    "ios": {
      "bundleIdentifier": "com.walletai.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-updates",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Captura de tela 2026-10-20 103242.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14",
          "dark": {
            "backgroundColor": "#0B0F14"
          }
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/65d50a05-d803-4da3-af32-4cdb34f1df9c",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65d50a05-d803-4da3-af32-4cdb34f1df9c"
      }
    },
    "owner": "jonas_menezes",
    "icon": "./assets/wallet-icon.png"
  }
}
